{
    "timeout": 10,
    "source": {
        "directories": [
            "app"
        ],
        "excludes": [
            "app/Console/Kernel.php",
            "app/Exceptions/Handler.php"
        ]
    },
    "logs": {
        "text": "infection.log",
        "html": "infection.html",
        "summary": "infection-summary.log"
    },
    "tmpDir": "build/infection",
    "phpUnit": {
        "configDir": "."
    },
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "bootstrap": "vendor/autoload.php",
    "coverage": "coverage.xml",
    "minMsi": 80,
    "minCoveredMsi": 80
}
